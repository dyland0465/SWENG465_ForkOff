# Explicit local opt-in. Copy to .env.local, then restart Vite.
# Optimized staging builds also require VITE_APP_ENV=staging at BUILD time.
# Real production: VITE_APP_ENV=production, VITE_ENABLE_PARTNER_DEMO=false.
# These public UI flags do not protect access. See docs/partner-demo-staging.md.
VITE_APP_ENV=development
VITE_ENABLE_PARTNER_DEMO=true
